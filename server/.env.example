# Copy this file to ".env" and change the values.
PORT=5000

# Long random text used to sign login tokens. Change it! Example generator:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Address of the React app (allowed by CORS)
CLIENT_URL=http://localhost:5173

# Optional
# DB_PATH=./data/hbk.db
# UPLOAD_DIR=./uploads
# AUTH_RATE_LIMIT=30
